# Default: auto-detect text, normalize to LF in repo
* text=auto eol=lf

# Force LF for code/text
*.js   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.svg  text eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Binary assets (no diff / no eol conversion)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp3   binary
*.ogg   binary
*.wav   binary
*.mp4   binary
*.webm  binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.zip   binary
*.psd   binary
*.pdf   binary
